# 复制为 .env 后再填真实值
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 可选
MAX_STEPS=8
STALL_LIMIT=2
TEMPERATURE=0.3

# 成本与超时保护
MAX_TOKENS=60000
STEP_TIMEOUT=60
MAX_TOOL_RESULT=4000
# 单价按「元 / 百万 token」填；两项都填了才会估算费用
PRICE_INPUT=0
PRICE_OUTPUT=0
MAX_COST=0
